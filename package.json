{
  "name": "check-eta",
  "version": "0.3.0",
  "type": "module",
  "private": true,
  "packageManager": "bun",
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "generate-sitemap": "bun run scripts/generate-sitemap.ts",
    "build": "bun run generate-sitemap && vite build",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy --message \"$(git log -1 --pretty=%s)\" --tag \"$(git rev-parse --short HEAD)\"",
    "lint": "biome check --write",
    "format": "biome format --write"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "latest",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "maplibre-gl": "^5.24.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tanstack/router-cli": "^1.167.38",
    "@tanstack/router-plugin": "latest",
    "@types/geojson": "^7946.0.16",
    "@types/node": "26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wrangler": "^4.141.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
