{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/src/components/ui",
      "!!**/node_modules",
      "!!**/dist",
      "!**/src/routeTree.gen.ts",
      "!**/src/styles/global.css"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": { "useSortedClasses": "warn" },
      "style": {
        "useBlockStatements": "warn",
        "useConsistentMemberAccessibility": "error",
        "useConsistentArrayType": "error",
        "noInferrableTypes": "error",
        "noNamespace": "error",
        "useConsistentObjectDefinitions": "warn"
      },
      "suspicious": {
        "noVar": "error",
        "noUnknownAtRules": "error"
      },
      "complexity": { "useArrowFunction": "error" }
    },
    "domains": {
      "react": "recommended",
      "tailwind": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "trailingCommas": "es5",
      "semicolons": "always",
      "quoteStyle": "double",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "linter": {
      "enabled": false
    }
  },
  "assist": { "enabled": true, "actions": { "preset": "recommended" } },
  "overrides": [
    {
      "includes": ["src/features/bus/types.ts", "src/features/metro/types.ts"],
      "linter": {
        "rules": {
          "style": {
            "useNamingConvention": "off"
          }
        }
      }
    }
  ]
}
